  +'</div>'
 ).join('');
}

function selectEvent(id){const e=allEvents.find(x=>x.id===id);if(e)analyzeEvent(e)}
async function analyzeSelected(){
 const ids=document.getElementById('eventIds').value.split(',').map(x=>x.trim()).filter(Boolean);
 if(!ids.length)return alert('请输入事件 ID');
 const e=allEvents.find(x=>x.id===ids[0]);
 if(!e)return alert('找不到该 ID');
 await analyzeEvent(e);
}

async function analyzeEvent(e){
 go('page3');
 document.getElementById('analysisTitle').innerHTML='<b>'+esc(e.id)+' · '+esc(e.event)+'</b><br><span class="muted small">'+esc(e.beijing_time||'-')+timeTag(e.date_status||'')+' · ESS '+esc(e.ESS)+' · '+esc(e.ESS_text)+'</span>';
 document.getElementById('analysisResult').innerHTML='<div class="panel small muted">正在分析…</div>';
 try{
  const t=today();
  const prompt='今天是'+t+'。分析以下未来科技事件：\n'+JSON.stringify(e,null,2)+'\n\n给出六维 Risk Value 评分（-100~+100）和 Surprise：\n- f_fundamental 基本面/产业需求\n- f_tech 产品/技术结果\n- f_policy 政策/政府\n- f_pricedin 市场预期/Price-in\n- f_compete 竞争/供应链\n- f_certainty 信息确定性\n- surprise S1~S5\n\n严格输出JSON：\n{"time_confidence":"已确认/预计/待核实","summary":"总结","facts":["已知1"],"unknowns":["未核实1"],"impact_path":["路径1"],"scenarios":[{"direction":"利多","probability":40,"reason":"原因"}],"positives":["利多1"],"negatives":["利空1"],"sources":["来源1"],"f_fundamental":20,"f_tech":30,"f_policy":10,"f_pricedin":-10,"f_compete":15,"f_certainty":25,"surprise":"S3"}';
  const out=await callLLM([{role:'user',content:prompt}]);
  let a;
  try{a=tryParse(out);}catch(err){renderFallback(out);return;}
  renderAnalysis(a,e);
 }catch(err){
  document.getElementById('analysisResult').innerHTML='<div class="panel error">'+esc(err.message)+'</div>';
 }
}

