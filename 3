<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>科技重大事件侦察系统</title>
<style>
:root{--panel:#111a2b;--line:#293852;--text:#e7edf7;--muted:#9eacc3;--blue:#65b7ff;--yellow:#f5c451;--green:#4ade80;--red:#fb7185}
*{box-sizing:border-box}
html,body{overflow-x:hidden;max-width:100%}
body{margin:0;background:linear-gradient(135deg,#070b14,#0b1424 55%,#101b30);color:var(--text);font-family:Inter,Arial,"Microsoft YaHei",sans-serif}
header{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--line);position:sticky;top:0;background:#080d18ee;backdrop-filter:blur(12px);z-index:5}
.brand{font-weight:800;font-size:14px}.brand span{color:var(--blue)}.status{font-size:11px;color:var(--muted)}
main{max-width:900px;margin:auto;padding:18px 14px 90px}
.page{display:none}.page.active{display:block}
.eyebrow{color:var(--blue);font-size:11px;letter-spacing:2px;text-transform:uppercase}
h1{font-size:22px;margin:8px 0 12px}h2{font-size:15px;margin:0 0 12px;color:var(--blue)}
p{line-height:1.7;color:#c3cee0;font-size:14px;margin:8px 0}
.muted{color:var(--muted)}
.panel{background:linear-gradient(145deg,var(--panel),#0e1727);border:1px solid var(--line);border-radius:14px;padding:16px;margin:12px 0}
button{border:0;border-radius:8px;padding:10px 14px;background:#2785e8;color:white;font-weight:700;cursor:pointer;font-size:14px}
button.secondary{background:#24344e;color:#dce8fa;border:1px solid #3a4b68}
button:disabled{opacity:.45}
.controls{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:10px 0}
input,select,textarea{background:#0b1423;color:var(--text);border:1px solid #34445e;border-radius:8px;padding:10px;font:inherit;width:100%}
input[readonly]{background:#0a1017;color:#a9c9f1;border-color:#1e2c40;cursor:default}
textarea{min-height:70px;resize:vertical}
label{display:block;color:#cbd8eb;font-size:13px;margin:10px 0 4px}
.small{font-size:12px}
.ev-card{background:#0d1728;border:1px solid var(--line);border-radius:12px;padding:14px;margin:10px 0}
.ev-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:8px}
.ev-id{color:var(--blue);font-weight:800;font-size:13px}
.ev-time{color:var(--blue);font-weight:700;font-size:15px;text-align:right}
.ev-title{font-size:15px;font-weight:700;color:#fff;margin:6px 0}
.ev-row{display:flex;gap:8px;font-size:13px;padding:5px 0;border-bottom:1px dashed #1e2c40}
.ev-row:last-of-type{border-bottom:0}
.ev-k{color:#8fa3bd;min-width:52px;flex-shrink:0}
.ev-v{color:#dde7f5;flex:1;word-break:break-word}
.ev-foot{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid #1e2c40}
.ev-metrics{font-size:12px;color:#c8d6ea}
.ev-metrics b{color:var(--yellow)}
.grade-1{background:#4a1d22;color:#fb7185;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:700}
.grade-2{background:#4a3a1d;color:#f5c451;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:700}
.grade-3{background:#1e3a5f;color:#65b7ff;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:700}
.time-tag{display:inline-block;font-size:10px;padding:2px 6px;border-radius:99px;margin-left:4px}
.t-conf{background:#1e4530;color:#4ade80}
.t-est{background:#453a1e;color:#f5c451}
.t-unk{background:#3a2a2a;color:#fb7185}
.ana-section{background:linear-gradient(145deg,#111a2b,#0e1727);border:1px solid #293852;border-radius:12px;margin:14px 0;overflow:hidden}
.ana-title{background:#142138;color:#65b7ff;padding:11px 14px;font-weight:700;font-size:13px;border-bottom:1px solid #293852}
.ana-field{padding:13px 14px;border-bottom:1px solid #1e2c40}
.ana-field:last-child{border-bottom:0}
.ana-label{color:#8fa3bd;font-size:11px;margin-bottom:6px;font-weight:700;letter-spacing:.5px}
.ana-value{color:#e7edf7;font-size:14px;line-height:1.75;word-break:break-word}
.ana-value ul{margin:0;padding-left:18px}
.ana-value li{margin:5px 0}
.bull{color:#4ade80}.bear{color:#fb7185}.neu{color:#9eacc3}
.today-badge{background:#1e3a5f;color:#65b7ff;padding:4px 10px;border-radius:99px;font-size:12px;font-weight:700;display:inline-block}
.error{color:var(--red)}.good{color:var(--green)}
.footerbar{position:fixed;bottom:0;left:0;right:0;background:#080d18ee;border-top:1px solid var(--line);padding:10px 14px;display:flex;justify-content:space-between;gap:8px;z-index:6}
.bar{height:8px;background:#1e2c40;border-radius:99px;overflow:hidden;margin:6px 0}
.bar-in{height:100%;background:#65b7ff;width:0%;transition:width .3s}
.six-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:6px}
.six-item{background:#0b1423;border:1px solid #1e2c40;border-radius:8px;padding:8px 6px;text-align:center}
.six-item .n{color:#65b7ff;font-weight:700;font-size:16px}
.six-item .l{color:#8fa3bd;font-size:10px;margin-top:2px}
.formula{font-family:monospace;font-size:11px;color:#8fa3bd;background:#0b1423;padding:8px;border-radius:6px;margin:6px 0;line-height:1.6}
</style>
<script>
// ===== PWA 图标：深红渐变 + 地球经纬线 + 四角星 =====
(function(){
  const SVG = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'>" +
    "<defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>" +
    "<stop offset='0' stop-color='#c1132a'/><stop offset='1' stop-color='#5c000e'/>" +
    "</linearGradient></defs>" +
    "<rect width='512' height='512' rx='115' fill='url(#g)'/>" +
    "<g opacity='0.22' stroke='#ffffff' stroke-width='6' fill='none'>" +
    "<circle cx='256' cy='256' r='175'/>" +
    "<ellipse cx='256' cy='256' rx='80' ry='175'/>" +
    "<ellipse cx='256' cy='256' rx='175' ry='80'/>" +
    "<line x1='81' y1='256' x2='431' y2='256'/>" +
    "</g>" +
    "<path d='M256 106 C266 186 300 220 380 230 C300 240 266 274 256 354 C246 274 212 240 132 230 C212 220 246 186 256 106 Z' fill='#ffffff'/>" +
    "</svg>";
  const iconUrl = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(SVG);

  // favicon
  let link = document.createElement('link');
  link.rel = 'icon';
  link.type = 'image/svg+xml';
  link.href = iconUrl;
  document.head.appendChild(link);

  // apple-touch-icon（iOS 加到主屏幕用这个）
  let at = document.createElement('link');
  at.rel = 'apple-touch-icon';
  at.href = iconUrl;
  document.head.appendChild(at);
  let atPre = document.createElement('link');
  atPre.rel = 'apple-touch-icon-precomposed';
  atPre.href = iconUrl;
  document.head.appendChild(atPre);

  // theme-color（安卓状态栏颜色）
  let tc = document.createElement('meta');
  tc.name = 'theme-color';
  tc.content = '#8b0016';
  document.head.appendChild(tc);

  // 安卓 PWA 需要的 manifest
  const manifest = {
    name: "科技重大事件侦察系统",
    short_name: "科技雷达",
    start_url: ".",
    scope: ".",
    display: "standalone",
    orientation: "portrait",
    background_color: "#0b1424",
    theme_color: "#8b0016",
    icons: [
      { src: iconUrl, sizes: "192x192", type: "image/svg+xml", purpose: "any" },
      { src: iconUrl, sizes: "512x512", type: "image/svg+xml", purpose: "any maskable" }
    ]
  };
  try {
    const blob = new Blob([JSON.stringify(manifest)], { type: 'application/manifest+json' });
    const murl = URL.createObjectURL(blob);
    let ml = document.createElement('link');
    ml.rel = 'manifest';
    ml.href = murl;
    document.head.appendChild(ml);
  } catch(e) {}
})();
</script>
</head>
<body>
<header><div class="brand">◈ <span>TECH RADAR</span> / 科技事件侦察</div><div id="status" class="status">检查连接…</div></header>
<main>

<section id="page1" class="page active">
<div class="eyebrow">Technology Major Events Intelligence Radar</div>
<h1>全球科技重大事件侦察系统</h1>
<p class="small muted">张量搜索 · Gate A-D · ESS 公式 · Impact I1-I5 · Risk Value 公式 · Surprise S1-S5</p>

<div class="panel">
<h2>当前基准日期</h2>
<div><span class="today-badge" id="todayShow">加载中…</span></div>
</div>

<div class="panel">
<h2>🔌 连接设置（Google Gemini）</h2>
<label>Gemini API Key</label>
<input id="apiKey" type="password" autocomplete="new-password" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="粘贴你的 Gemini Key">
<label>模型（点下方按钮自动获取，或手动选）</label>
<select id="llmModel">
<option value="gemini-3.8-flash">Gemini 3.8 Flash（推荐）</option>
<option value="gemini-3.7-flash">Gemini 3.7 Flash</option>
