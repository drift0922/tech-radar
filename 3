<script>
const EP='https://generativelanguage.googleapis.com/v1beta/openai/chat/completions';
const MODELS_API='https://generativelanguage.googleapis.com/v1beta/models';
let eventData=null;let allEvents=[];

const TENSOR=[
 {name:'AI / GPU / 半导体 / 存储',keys:'大模型发布、GPU新品、代工产能、HBM/DRAM/NAND、算力采购、芯片出口管制、晶圆厂投资、先进封装'},
 {name:'数据中心 / 电力 / 网络 / 机器人',keys:'AI数据中心建设、电力采购、核电/天然气、电网扩容、光模块、800G/1.6T、人形机器人、Robotaxi、苹果/华为产品发布、CES'},
 {name:'科技政策 / 融资 / 财报 / 订单',keys:'美国商务部/能源部/国防部、欧盟AI法案、半导体政策、政府采购、AI融资、IPO、科技巨头财报、GPU订单、云订单、国家AI战略'}
];

function calcESS(r,c,a,s,p,t){
 return Math.round(r*0.30 + c*0.20 + a*0.15 + s*0.15 + p*0.10 + t*0.10);
}
function essGrade(ess){
 if(ess>=85)return {level:1,text:'一级重大',cls:'grade-1'};
 if(ess>=70)return {level:2,text:'二级重要',cls:'grade-2'};
 if(ess>=55)return {level:3,text:'观察',cls:'grade-3'};
 return {level:0,text:'过滤',cls:''};
}
function calcRisk(f,t,p,pd,c,ct){
 return Math.round(f*0.25 + t*0.20 + p*0.15 + pd*0.15 + c*0.15 + ct*0.10);
}
function riskStatus(v){
 if(v>=81)return {t:'极度乐观',c:'bull'};
 if(v>=61)return {t:'明显乐观',c:'bull'};
 if(v>=21)return {t:'偏乐观',c:'bull'};
 if(v>=-20)return {t:'多空平衡',c:'neu'};
 if(v>=-60)return {t:'偏悲观',c:'bear'};
 if(v>=-80)return {t:'明显悲观',c:'bear'};
 return {t:'极度悲观',c:'bear'};
}
function gatePass(g){return g===true||g==='true'||g==='Pass'||g==='pass'||g===1;}

function dateKey(t){
 if(!t)return 99999999;
 const ym=t.match(/(\d{4})年/);
 if(!ym)return 99999999;
 const y=parseInt(ym[1]);
 if(t.indexOf('上半年')>=0)return y*10000+600;
 if(t.indexOf('下半年')>=0)return y*10000+1200;
 const mm=t.match(/(\d{1,2})月/);
 const m=mm?parseInt(mm[1]):99;
 const dm=t.match(/(\d{1,2})日/);
 const d=dm?parseInt(dm[1]):99;
 return y*10000+m*100+d;
}

function today(){const d=new Date();return d.getFullYear()+'年'+(d.getMonth()+1)+'月'+d.getDate()+'日';}
function go(id){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo(0,0);}

async function refreshModels(){
 const k=document.getElementById('apiKey').value.trim();
 const box=document.getElementById('llmTestState');
 if(k.length<20){box.innerHTML='<span class="error">请先填 Key 再点自动获取</span>';return;}
 box.textContent='正在向 Google 获取可用模型列表…';
 try{
  const r=await fetch(MODELS_API+'?key='+encodeURIComponent(k));
  const d=await r.json();
  if(!r.ok)throw new Error((d.error&&d.error.message)||('HTTP '+r.status));
  const all=d.models||[];
  const chat=all.filter(m=>{
   const methods=m.supportedGenerationMethods||[];
   if(!methods.includes('generateContent'))return false;
   const n=(m.name||'').toLowerCase();
   if(n.includes('embedding'))return false;
   if(n.includes('aqa'))return false;
   if(n.includes('imagen'))return false;
   return true;
  }).map(m=>(m.name||'').replace(/^models\//,''));
  if(!chat.length){box.innerHTML='<span class="error">没有拿到可用模型</span>';return;}
  chat.sort((a,b)=>{
   const fa=/flash/.test(a)?0:1, fb=/flash/.test(b)?0:1;
   if(fa!==fb)return fa-fb;
   return b.localeCompare(a,'en',{numeric:true});
  });
  const sel=document.getElementById('llmModel');
  sel.innerHTML=chat.map(n=>'<option value="'+n+'">'+n+'</option>').join('');
  localStorage.setItem('orModels',JSON.stringify(chat));
  localStorage.setItem('orModel',chat[0]);
  box.innerHTML='<span class="good">成功获取 '+chat.length+' 个可用模型，已选：'+chat[0]+'</span>';
  document.getElementById('status').textContent='模型已刷新';
 }catch(e){
  box.innerHTML='<span class="error">自动获取失败：'+e.message+'</span>';
 }
}
function loadModelsFromCache(){
 try{
  const arr=JSON.parse(localStorage.getItem('orModels')||'null');
  if(arr&&arr.length){
   const sel=document.getElementById('llmModel');
   sel.innerHTML=arr.map(n=>'<option value="'+n+'">'+n+'</option>').join('');
   const cur=localStorage.getItem('orModel');
   if(cur)sel.value=cur;
  }
 }catch(e){}
}

function saveSettings(){
 const k=document.getElementById('apiKey').value.trim();
 const m=document.getElementById('llmModel').value;
 if(k.length<20){document.getElementById('llmTestState').innerHTML='<span class="error">Key 太短，请检查是否粘贴完整</span>';return false;}
 localStorage.setItem('orKey',k);localStorage.setItem('orModel',m);
 document.getElementById('llmTestState').textContent='已保存，模型：'+m;return true;
}
function loadSettings(){
 const k=localStorage.getItem('orKey')||'';
 if(k)document.getElementById('apiKey').value=k;
 loadModelsFromCache();
 const m=localStorage.getItem('orModel')||'';
 if(m){const sel=document.getElementById('llmModel');if(sel.querySelector('option[value="'+m+'"]'))sel.value=m;}
}
async function callLLM(messages){
 const k=localStorage.getItem('orKey');
 const m=localStorage.getItem('orModel')||document.getElementById('llmModel').value;
 if(!k)throw new Error('请先填 Key 并保存。');
 let r;
 try{r=await fetch(EP,{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+k},body:JSON.stringify({model:m,messages,temperature:0.4})});}
 catch(e){throw new Error('无法连接：'+e.message)}
 const raw=await r.text();let d;
 try{d=JSON.parse(raw)}catch(e){throw new Error('返回非 JSON：'+raw.slice(0,180))}
 if(!r.ok)throw new Error((d.error&&d.error.message)||('HTTP '+r.status+'，模型：'+m));
 const out=d.choices&&d.choices[0]&&d.choices[0].message&&d.choices[0].message.content;
 if(!out)throw new Error('模型无输出');
 return out;
}
async function testConn(){
 if(!saveSettings())return;
 const box=document.getElementById('llmTestState');box.textContent='测试中…';
 try{const out=await callLLM([{role:'user',content:'只回复：连接成功'}]);box.innerHTML='<span class="good">连接成功：'+out.slice(0,50)+'</span>';document.getElementById('status').textContent='已连接';}
 catch(e){box.innerHTML='<span class="error">失败：'+e.message+'</span>';}
}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function arr(v){return Array.isArray(v)?v.join('、'):(v||'')}
function timeTag(s){
 if(!s)return '';
 if(s.indexOf('已确认')>=0)return '<span class="time-tag t-conf">已确认</span>';
 if(s.indexOf('预计')>=0)return '<span class="time-tag t-est">预计</span>';
 return '<span class="time-tag t-unk">待核实</span>';
}
function isFuture(t){
 if(!t)return true;
 const m=t.match(/(\d{4})年/);if(!m)return true;
 return parseInt(m[1])>=new Date().getFullYear();
}
function tryParse(out){
 let clean=out.replace(/^```json\s*/i,'').replace(/^```\s*/,'').replace(/\s*```$/,'').trim();
 const s=clean.indexOf('{');const e=clean.lastIndexOf('}');
 if(s>=0&&e>s)clean=clean.slice(s,e+1);
 return JSON.parse(clean);
}

async function runRound(round,scope,t){
 const prompt='【当前日期】'+t+'。只能列出该日期之后的未来事件。\n【本轮维度】'+round.name+'\n【关键词】'+round.keys+'\n【时间范围】'+scope+'\n\n列出最多8条未来科技重大事件。每条必须给出六维评分（0-100整数）和 Gate 判断：\n- R 市场重定价潜力\n- C 产业链穿透力\n- A 主体重要性\n- S 预期差\n- P 政策杠杆\n- T 时间紧迫性\n- gate_a 是否科技相关(true/false)\n- gate_b 是否真实事件(true/false)\n- gate_c 是否新增信息(true/false)\n- gate_d 是否可验证(true/false)\n- impact 影响范围(I1/I2/I3/I4/I5)\n\n【时间强制】官方公布→"YYYY年M月D日"+date_status="已确认"；惯例可推→"YYYY年M月"+date_status="预计（基于行业惯例）"；仅范围→"YYYY年上半年"+date_status="待核实"。禁止全部写"待核实"。\n\n严格输出JSON：\n{"main_events":[{"beijing_time":"2026年12月","date_status":"预计（基于行业惯例）","event":"事件名","entity":"主体","type":"类型","domains":["领域"],"R":80,"C":75,"A":90,"S":70,"P":60,"T":85,"gate_a":true,"gate_b":true,"gate_c":true,"gate_d":true,"impact":"I3","why_important":"重要性"}]}';
 const out=await callLLM([{role:'system',content:'你是未来科技事件助手。当前日期'+t+'，只输出该日之后的事件。'},{role:'user',content:prompt}]);
 return tryParse(out).main_events||[];
}

async function discover(){
 const btn=document.getElementById('discoverBtn');btn.disabled=true;
 const prog=document.getElementById('prog');prog.style.width='0%';
 const scope=document.getElementById('scope').value;
 const t=today();
 const list=TENSOR.slice();
 const focus=document.getElementById('focus').value.trim();
 if(focus)list.push({name:'用户关注重点', keys: focus});
 const custom=document.getElementById('customQuery').value.trim();
 if(custom){
  const items=custom.split(/[\n,，;；]+/).map(s=>s.trim()).filter(Boolean);
  if(items.length)list.push({name:'自定义点名搜索', keys: items.join('、')});
 }
 document.getElementById('discoverState').textContent='并行扫描 '+list.length+' 个维度，请稍候…';
 let done=0;
 const tasks=list.map(r=>{
  const timeout=new Promise((_,rej)=>setTimeout(()=>rej(new Error('timeout')),90000));
  return Promise.race([runRound(r,scope,t),timeout])
   .catch(()=>[])
   .then(items=>{done++;prog.style.width=Math.round(done/list.length*100)+'%';return items;});
 });
 const allResults=await Promise.all(tasks);
 let raw=allResults.flat();
 const seen=new Set();const uniq=[];
 raw.forEach(e=>{
  const key=((e.event||'')+'|'+(e.entity||'')).toLowerCase().replace(/\s/g,'');
  if(key&&!seen.has(key)){seen.add(key);uniq.push(e)}
 });
 const passed=[];
 uniq.forEach(e=>{
  if(!(gatePass(e.gate_a)&&gatePass(e.gate_b)&&gatePass(e.gate_c)&&gatePass(e.gate_d)))return;
  if(!isFuture(e.beijing_time))return;
  const ess=calcESS(Number(e.R)||50,Number(e.C)||50,Number(e.A)||50,Number(e.S)||50,Number(e.P)||50,Number(e.T)||50);
  const g=essGrade(ess);
  if(g.level===0)return;
  passed.push(Object.assign({},e,{ESS:ess,ESS_level:g.level,ESS_text:g.text,ESS_cls:g.cls}));
 });
 passed.sort((a,b)=>{
  const da=dateKey(a.beijing_time),db=dateKey(b.beijing_time);
  if(da!==db)return da-db;
  return b.ESS-a.ESS;
 });
 passed.forEach((e,i)=>{e.id='E'+String(i+1).padStart(3,'0')});
 eventData={main_events:passed};allEvents=passed;
 document.getElementById('discoverState').textContent='完成：扫描 '+list.length+' 轮，原始 '+raw.length+' 条 → 通过 Gate + ESS ≥55 共 '+passed.length+' 条。已按时间从近到远排序。';
 renderEvents();
 btn.disabled=false;
}

