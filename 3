<option value="gemini-3.5-flash">Gemini 3.5 Flash</option>
<option value="gemini-3.5-flash-lite">Gemini 3.5 Flash-Lite（最快）</option>
<option value="gemini-3.1-flash-lite">Gemini 3.1 Flash-Lite</option>
</select>
<div class="controls">
<button onclick="saveSettings()">保存</button>
<button class="secondary" onclick="testConn()">测试连接</button>
<button class="secondary" onclick="refreshModels()">🔄 自动获取模型列表</button>
</div>
